filters:
  and:
    - 'file.ext == "md"'
    - '!file.inFolder("90-System")'
    - '!file.inFolder("40-Archive")'
    - '!file.name.contains("_Index")'
    - 'file.backlinks.isEmpty()'
    - 'file.links.isEmpty()'

formulas:
  age_days: '(now() - file.ctime).days.round(0)'

properties:
  formula.age_days:
    displayName: "Age (days)"

views:
  - type: table
    name: Unconnected notes
    order:
      - file.name
      - file.folder
      - formula.age_days
